# Dev: where vite's /api proxy points (docker compose publishes the backend on 3500).
# A local `cargo run --bin backend` uses LISTEN_ADDR, default 0.0.0.0:3400.
VITE_API_BASE=http://localhost:3500

# Prod (`pnpm start`): backend origin for the SSR catch-all proxy in src/routes/api.$.ts
# and for SSR-side queries.
API_BASE=http://localhost:3500

# Prod listener.
PORT=3000
HOST=0.0.0.0

# Proxy request-body cap in MB; matches the backend's per-screenshot multipart limit.
UPLOAD_MAX_SIZE_MB=25
