# 本番デプロイ用の環境変数サンプル。
# デプロイ先の環境変数として、必要な行を KEY=value のフラット形式で注入する
# （dokploy なら Compose アプリの Environment 欄に貼り付ける）。
# docker-compose.prod.yml の ${VAR} がこれらで解決される。
#
# シークレットは実値をコミットしないこと。下の生成コマンドの出力を Environment に貼る。
#   32 文字以上のシークレット:  openssl rand -base64 48
#
# ★任意項目（S3 / GitHub App）は、使わないならコメントアウトのまま残すこと。
#   `KEY=` と空値で置いてはいけない。backend の設定読み込みは「未設定」と「空文字」を
#   区別し、GITHUB_APP_ID（Option<u64>）や S3_FORCE_PATH_STYLE（Option<bool>）へ
#   空文字が渡ると型変換に失敗して起動しない。GITHUB_API_BASE_URL は Some("") になり
#   既定の https://api.github.com が効かなくなる。
# ローカル検証だけしたいときは、実値を埋めたうえで:
#   docker compose -f docker-compose.prod.yml --env-file .env.production.example config

# ============================================================
# 必須
# ============================================================

# --- DB（db サービスの初期化と backend の接続先で値を合わせる）---
POSTGRES_USER=vrt
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vrt
# ホストは compose のサービス名 db、ポートは内部の 5432。上の USER/PASSWORD/DB と一致させる。
DATABASE_URL=postgresql://vrt:change-me-strong-password@db:5432/vrt

# --- Redis / Valkey（サービス名 redis、内部ポート 6379）---
REDIS_URL=redis://redis:6379

# --- 公開 URL ---
# APP_URL と ALLOW_ORIGIN は同じ公開 URL を指すこと。
# APP_URL は http/https の絶対 URL でバリデーションあり（不正だと起動拒否）。
APP_URL=https://vrt.example.com
# ★最頻出の罠★ ブラウザからの書き込みの Origin 検査に使う。バリデーションが無いため
# 設定漏れでも無警告で起動し、本番ドメインからの操作だけが弾かれる。APP_URL と同じ値にする。
ALLOW_ORIGIN=https://vrt.example.com

# --- シークレット（32 文字以上。openssl rand -base64 48 で生成した値を貼る）---
PERSONAL_TOKEN_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- OAuth クライアント ---
# GitHub は実運用で使うなら実値を設定する。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitLab を使わなくてもキー自体は必須（無いと backend が起動しない）。空文字のまま残す。
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- ストレージ backend: local | s3 ---
# local はアップロードを uploads ボリュームへ保存する。s3 は下の S3 セクションを設定する。
STORAGE_BACKEND=local

# ※ TEST_LOGIN_ENABLED は絶対に設定しないこと（認証を完全にバイパスする）。ここには載せない。

# ============================================================
# S3 を使う場合（STORAGE_BACKEND=s3 のときのみ。欠けると起動時に落ちる）
# ============================================================
# バケットは private のままでよい。画像は backend 経由でプロキシ配信され、公開 URL は使わない。
#S3_ENDPOINT=https://s3.example.com
#S3_BUCKET=vrt
#S3_REGION=auto
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# MinIO・R2 等でパススタイルが要る場合のみ 1/true/yes。
#S3_FORCE_PATH_STYLE=true

# ============================================================
# GitHub App を使う場合（任意。PR ステータス連携）
# ============================================================
# APP_ID と PRIVATE_KEY_PEM の両方が揃って初めて有効。片方だけだと警告のみで無言で無効。
# PEM は改行を \n にエスケープして 1 行で渡す（起動時に実改行へ戻される）。詳細は docs/github-app.md。
#GITHUB_APP_ID=123456
#GITHUB_APP_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n
#GITHUB_WEBHOOK_SECRET=
# GitHub Enterprise のときだけ（既定は https://api.github.com）。
#GITHUB_API_BASE_URL=https://github.example.com/api/v3
